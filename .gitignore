*log*/


# Ignore files containing 'log' in their name
*log*
# But don't ignore these two...
!gradient_logger
!weight_logger
# salt's own logging facility and its test are source, not log output
!salt/utils/logging.py
!salt/tests/unit/utils/test_logging.py

